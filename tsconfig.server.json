{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "app.js",
    "app/**/*.js",
    "node_modules/nhsuk-prototype-kit/**/*.js"
  ],
  "exclude": [
    "app/javascripts",
    "app/views/components",
    "node_modules/nhsuk-prototype-kit/lib/javascripts/**/*.js",
    "**/*.test.js"
  ]
}
